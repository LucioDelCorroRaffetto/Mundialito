# ─── Worker (Node.js) ────────────────────────────────────────────────────────

# Turso (libSQL) — get from https://turso.tech
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# VAPID Push Notifications — generate with: node packages/api/scripts/generate-vapid.mjs
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@mundialito.app
