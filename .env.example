# ─── Frontend (Vite) ─────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:3000/api/v1
VITE_WS_URL=ws://localhost:3000

# ─── API / Worker (Node.js) ──────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# Turso (libSQL) — get from https://turso.tech
TURSO_DATABASE_URL=libsql://your-db.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# JWT — generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=change-me-access-secret-64-chars-minimum
JWT_REFRESH_SECRET=change-me-refresh-secret-64-chars-minimum

# VAPID Push Notifications — generate with: node packages/api/scripts/generate-vapid.mjs
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@mundialito.app

# CORS — comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:5174,https://yourdomain.vercel.app

# Google OAuth (https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# API-Football (https://www.api-football.com) — 100 req/day free (worker only)
API_FOOTBALL_KEY=your-api-football-key
API_FOOTBALL_LEAGUE_ID=1
API_FOOTBALL_SEASON=2026
API_FOOTBALL_DAILY_LIMIT=95
